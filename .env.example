# Application
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=truck_routing
POSTGRES_USER=truck_routing
POSTGRES_PASSWORD=truck_routing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Routing provider: unset (or blank) keeps the deterministic mock adapter.
# "osrm" selects the road-following OSRM/Photon adapter (no credentials,
# needs internet). A dotted "module.Object" path selects a custom adapter.
TRUCKSAFE_ROUTING_PROVIDER=

# Weather provider: same selection scheme as the routing provider.
# Only the deterministic mock adapter exists in this slice.
TRUCKSAFE_WEATHER_PROVIDER=

# Frontend (bundled into the client; never secrets)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_STYLE_URL=