# Base URL of the TruckSafe API (without trailing slash).
# Same-origin default: the Vite dev server proxies /api to the Django
# backend on localhost:8000. These values are bundled into the client and
# are never secret.
VITE_API_BASE_URL=/api/v1
# MapLibre style document URL (public CARTO Positron style by default).
# Set to an empty string to disable the map and always show the fallback.
VITE_MAP_STYLE_URL=
